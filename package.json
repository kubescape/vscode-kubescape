{
  "name": "kubescape",
  "preview": true,
  "displayName": "Kubescape",
  "description": "Kubescape extension for vscode",
  "author": {
    "name": "Kubescape Team at Armo"
  },
  "license": "Apache-2.0",
  "icon": "images/logo.png",
  "version": "0.4.0",
  "publisher": "kubescape",
  "engines": {
    "vscode": "^1.92.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kubescape/vscode-kubescape"
  },
  "bugs": {
    "url": "https://github.com/kubescape/vscode-kubescape/issues"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "container",
    "kubernetes",
    "kubescape",
    "security",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:json",
    "onCommand:kubescape.restartServer",
    "onCommand:kubescape.showOutput",
    "onCommand:kubescape.scanYaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kubescape.restartServer",
        "title": "Kubescape: Restart Language Server"
      },
      {
        "command": "kubescape.showOutput",
        "title": "Kubescape: Show Language Server Output"
      },
      {
        "command": "kubescape.scanYaml",
        "title": "Kubescape: Scan YAML"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Kubescape",
      "properties": {
        "kubescape.executablePath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to the Kubescape CLI executable (defaults to resolving 'kubescape' from system PATH)"
        },
        "kubescape.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces communication between VS Code and the Kubescape Language Server"
        },
        "kubescape.dirPath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Legacy directory path for Kubescape executable (deprecated: use 'kubescape.executablePath' instead)"
        },
        "kubescape.scanOnSave": {
          "type": "string",
          "enum": [
            "all",
            "yaml",
            "none"
          ],
          "default": "all",
          "description": "Legacy setting: Kubescape Language Server automatically scans Kubernetes manifests when saved. This setting has no effect on the language server.",
          "deprecationMessage": "Automatic save-triggered scanning is built into the Kubescape Language Server. This setting is deprecated and has no effect."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "mocha --timeout 60000 out/test/suite/**/*.test.js",
    "test:integration": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/jsdom": "^16.2.14",
    "@types/mocha": "^9.0.0",
    "@types/node": "18.x",
    "@types/node-fetch": "^2.5.7",
    "@types/vscode": "^1.82.0",
    "@typescript-eslint/eslint-plugin": "^4.31.1",
    "@typescript-eslint/parser": "^4.31.1",
    "@vscode/test-electron": "^1.6.2",
    "eslint": "^7.32.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.5",
    "vsce": "^2.14.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
